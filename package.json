{
  "name": "card-editor",
  "private": true,
  "version": "0.3.41",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --host 0.0.0.0 --port 1420",
    "desktop": "node scripts/run-desktop.mjs",
    "desktop:exe": "dotnet publish desktop/TMD.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:EnableCompressionInSingleFile=true -o desktop/dist && node scripts/copy-exe.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve": "vite preview --host 0.0.0.0 --port 1420 --strictPort",
    "pack": "node scripts/pack.mjs",
    "import-ankh": "node scripts/import-ankh.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "ag-psd": "^31.0.2",
    "konva": "^9.3.22",
    "pdf-lib": "^1.17.1",
    "peerjs": "^1.5.5",
    "pngjs": "^7.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-konva": "^19.0.7",
    "react-router-dom": "^7.8.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
